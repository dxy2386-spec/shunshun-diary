# 复制为 .env 后填写自己的密钥，重启服务即可启用真实 AI。
# 留空时使用内置的本地健康规则分析，不联网也能用。
AI_API_KEY=sk-9f52d4f72f3c47eba039e7608d1be195

# DeepSeek 示例（国内可直接使用，OpenAI 兼容接口）
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# OpenAI 示例：
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# 阿里云百炼 / Qwen 示例：
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus

# 服务配置
PORT=5173
HOST=0.0.0.0

# Render + Neon 免费方案：填入 Neon PostgreSQL 连接字符串
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# 公网公开注册模式：隐藏体验账号，开启更严格的注册限流
PUBLIC_MODE=0

# 放在 Cloudflare Tunnel / 反向代理后面时设为 1，以读取真实客户端 IP 和 HTTPS 协议
TRUST_PROXY=0

# 可选：单独控制体验账号，默认在 PUBLIC_MODE=1 时关闭
# DEMO_ENABLED=0
